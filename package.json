{
  "name": "maestro",
  "displayName": "Maestro",
  "description": "AI-powered developer workflow tool \u2014 Jira for AI Agents",
  "version": "0.1.0",
  "publisher": "bhuppi295",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhuppi295/maestro"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "maestro-sidebar",
          "title": "Maestro",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "maestro-sidebar": [
        {
          "type": "webview",
          "id": "maestro.mainView",
          "name": "Maestro"
        }
      ]
    },
    "commands": [
      {
        "command": "maestro.openPanel",
        "title": "Maestro: Open Panel"
      },
      {
        "command": "maestro.openInEditor",
        "title": "Open Maestro in Editor",
        "icon": "$(screen-full)",
        "category": "Maestro"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "maestro.openInEditor",
          "when": "view == maestro.mainView",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "maestro.openInEditor",
          "when": "activeWebviewPanelId != 'maestro.editorPanel'",
          "group": "navigation",
          "icon": "media/icon.svg"
        }
      ],
      "commandPalette": [
        {
          "command": "maestro.openInEditor"
        }
      ]
    }
  },
  "scripts": {
    "build:ext": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --format=cjs --sourcemap",
    "build:ui": "cd webview-ui && npm run build",
    "build": "npm run build:ext && npm run build:ui",
    "test": "esbuild src/services/analyze.service.test.ts --bundle --platform=node --format=cjs --outfile=out/analyze.service.test.js && node --test out/analyze.service.test.js",
    "watch:ext": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --format=cjs --sourcemap --watch",
    "watch:ui": "cd webview-ui && npm run dev",
    "vscode:prepublish": "npm run build",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.24.0"
  },
  "dependencies": {
    "simple-git": "^3.22.0"
  }
}
