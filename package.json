{
  "name": "maestro",
  "displayName": "Maestro",
  "description": "AI-powered developer workflow tool — Jira for AI Agents",
  "version": "0.1.14",
  "publisher": "bhuppi295",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhuppi295/maestro"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "maestro-sidebar",
          "title": "Maestro",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "maestro-sidebar": [
        {
          "type": "webview",
          "id": "maestro.mainView",
          "name": "Maestro"
        }
      ]
    },
    "commands": [
      {
        "command": "maestro.openPanel",
        "title": "Maestro: Open Panel"
      },
      {
        "command": "maestro.openInEditor",
        "title": "Open Maestro in Editor",
        "icon": "$(screen-full)",
        "category": "Maestro"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "maestro.openInEditor",
          "when": "view == maestro.mainView",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "maestro.openInEditor"
        }
      ]
    }
  },
  "scripts": {
    "build:ext": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --format=cjs --sourcemap",
    "build:ui": "cd webview-ui && npm run build",
    "build": "npm run build:ext && npm run build:ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npx tsc --noEmit -p tsconfig.json && cd webview-ui && npx tsc --noEmit -p tsconfig.json",
    "lint": "eslint src webview-ui/src",
    "lint:fix": "eslint src webview-ui/src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "watch:ext": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --format=cjs --sourcemap --watch",
    "watch:ui": "cd webview-ui && npm run dev",
    "vscode:prepublish": "npm run build",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "simple-git": "^3.22.0"
  }
}
